<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Читать данные «Тренировок» могут только приложения, подписанные тем же ключом. -->
    <permission
        android:name="ru.diary.training.permission.READ_DATA"
        android:protectionLevel="signature" />

    <!-- Разрешение на чтение данных «Рациона»: выдаётся системой, только если подпись совпадает. -->
    <uses-permission android:name="ru.diary.nutrition.permission.READ_DATA" />

    <!-- Видимость соседнего приложения на Android 11+. -->
    <queries>
        <package android:name="ru.diary.nutrition" />
    </queries>

    <!-- Уведомление об окончании отдыха; запрашивается в момент первого подхода, а не при запуске. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".TrainingApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Training">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".rest.RestTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Таймер отдыха между подходами во время тренировки" />
        </service>

        <provider
            android:name=".TrainingProvider"
            android:authorities="ru.diary.training.provider"
            android:exported="true"
            android:readPermission="ru.diary.training.permission.READ_DATA" />

        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <receiver
            android:name=".rest.RestAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
